{
  "manifest_version": 3,
  "name": "TV2 Subtitle Studio",
  "version": "0.5.0",
  "description": "Learn Norwegian while watching TV 2 Play: click-to-seek subtitles, live translation, and bilingual on-video captions.",
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.tv2.no/*"],
      "js": ["dist/content/net-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://play.tv2.no/*"],
      "js": ["dist/content/index.js"],
      "css": ["src/styles/overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://play.tv2.no/*",
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["public/icons/icon-128.png"],
      "matches": ["https://play.tv2.no/*"]
    }
  ]
}

